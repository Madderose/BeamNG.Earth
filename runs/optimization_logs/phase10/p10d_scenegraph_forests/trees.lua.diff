+-- Pure: the super-tile key ("anchor:sx_sy") grouping SUPER_TILE x SUPER_TILE 256 m veg and road-prop tiles.
+function M.superKey(anchorId, tileKey)
+  local tx, ty = tostring(tileKey):match('(%-?%d+)_(%-?%d+)$')
+  if not tx then return tostring(anchorId) .. ':' .. tostring(tileKey) end
+  local st = math.max(1, M.SUPER_TILE or 2)
+  local sx = math.floor((tonumber(tx) or 0) / st)
+  local sy = math.floor((tonumber(ty) or 0) / st)
+  return tostring(anchorId) .. ':' .. sx .. '_' .. sy
+end
+
